@{
    ViewData["Title"] = "Головна";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold text-primary mb-3">Ласкаво просимо до MessengerIPZ</h1>
    <p class="lead text-muted mb-5">Простий та швидкий спосіб спілкуватися з друзями та колегами у реальному часі.</p>

    <div class="d-flex justify-content-center gap-3">
        @if (User.Identity.IsAuthenticated)
        {
            <a href="/Home/Home" class="btn btn-success btn-lg px-5 shadow-sm">Перейти до чатів</a>
        }
        else
        {
            <a href="/Home/Login" class="btn btn-primary btn-lg px-5 shadow-sm">Увійти</a>
            <a href="/Home/Register" class="btn btn-outline-primary btn-lg px-5 shadow-sm">Зареєструватись</a>
        }
    </div>
</div>