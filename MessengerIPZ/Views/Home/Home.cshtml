@{
    ViewData["Title"] = "Мій чат";
}

<style>
    .chat-container {
        display: flex;
        gap: 20px;
        margin-top: 20px;
        height: 70vh;
    }

    .channels-panel {
        width: 35%;
        border-right: 1px solid var(--border-color);
        padding-right: 15px;
        overflow-y: auto;
    }

    .chat-panel {
        width: 65%;
        display: flex;
        flex-direction: column;
    }

    .messages-box {
        flex-grow: 1;
        border: 1px solid var(--border-color);
        background: var(--card-bg);
        border-radius: 8px;
        padding: 15px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 15px;
    }

    .msg-item {
        background: var(--chat-msg-bg);
        color: var(--chat-msg-text);
        padding: 8px 12px;
        border-radius: 15px;
        width: fit-content;
        max-width: 80%;
    }

        .msg-item.my-msg {
            background: #0d6efd;
            color: white;
            align-self: flex-end;
        }

    .channel-item {
        display: flex;
        flex-direction: column;
        padding: 12px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        margin-bottom: 10px;
        background: var(--card-bg);
    }

    .text-primary {
        color: #0d6efd !important;
    }
</style>

<div class="chat-container">
    <div class="channels-panel">

        <h4 id="roomsTitle" class="mb-3 text-primary">
            Кімнати
        </h4>

        <div class="input-group mb-4 shadow-sm">

            <input type="text"
                   id="channelName"
                   class="form-control"
                   placeholder="Назва">

            <button class="btn btn-primary" onclick="createChannel()">+</button>

        </div>

        <div id="channelsList"></div>

        <h4 id="usersTitle" class="mb-3 mt-4 text-primary">
            Користувачі
        </h4>
        <div id="usersList"></div>

    </div>

    <div class="chat-panel">

        <h4 id="chatHeader"
            class="border-bottom pb-2 text-primary">

            Оберіть канал

        </h4>

        <div id="messagesBox"
             class="messages-box shadow-sm">
        </div>

        <div class="input-group shadow-sm position-relative">
            <div id="emojiPicker" class="d-none rounded p-2 position-absolute shadow"
                 style="background-color: var(--card-bg); border: 1px solid var(--border-color); bottom: 100%; left: 0; z-index: 1000; width: 220px; display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 5px;">
            </div>

            <button class="btn btn-outline-secondary" type="button" id="emojiBtn" onclick="toggleEmojiPicker()" disabled>
                😀
            </button>

            <input type="text"
                   id="messageInput"
                   class="form-control"
                   placeholder="Повідомлення..."
                   disabled>

            <button class="btn btn-primary"
                    id="sendBtn"
                    onclick="sendMessage()"
                    disabled>
                >
            </button>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        const API = "/api";
        let currentChannelId = null;
        const currentUserName = '@User.Identity.Name';

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function (sender, content, timestamp) {
            const secret_key = "my_secret_key";
            const bytes = CryptoJS.AES.decrypt(content, secret_key);
            const decrypted = bytes.toString(CryptoJS.enc.Utf8);

            appendMessageToScreen(sender, decrypted, timestamp);
        });

        connection.start().then(() => { 

            applyHomeTranslations();

            loadChannels();

            loadUsers();

        });
        function applyHomeTranslations() {

            document.getElementById("roomsTitle").innerText =
                getText("rooms");

            const chatHeader =
                document.getElementById("chatHeader");

            if (
                chatHeader.innerText === "Оберіть канал"
                || chatHeader.innerText === "Select channel"
            ) {

                chatHeader.innerText =
                    getText("channel");
            }

            document.getElementById("channelName").placeholder =
                getText("channelName");

            document.getElementById("messageInput").placeholder =
                getText("message");
        }

        function formatMessageTime(date) {
            const now = new Date();
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const yesterday = new Date(today);
            yesterday.setDate(today.getDate() - 1);
    
            const msgDay = new Date(date.getFullYear(), date.getMonth(), date.getDate());
    
            const timeStr = date.toLocaleTimeString('uk-UA', { hour: '2-digit', minute: '2-digit' });
    
            if (msgDay.getTime() === today.getTime()) {
                return `Сьогодні ${timeStr}`;
            } else if (msgDay.getTime() === yesterday.getTime()) {
                return `Вчора ${timeStr}`;
            } else {
                const dateStr = date.toLocaleDateString('uk-UA', { day: '2-digit', month: '2-digit', year: 'numeric' });
                return `${dateStr} ${timeStr}`;
            }
        }

        function parseUtcDate(timeString) {
            if (!timeString) return new Date();
    
            let normalized = timeString.toString().replace(' ', 'T');
    
            normalized = normalized.replace(/(\.\d{3})\d+/, '$1');
    
            if (!normalized.endsWith('Z') && !normalized.includes('+')) {
                normalized += 'Z';
            }
    
            return new Date(normalized);
        }

        function appendMessageToScreen(sender, content, timeString) {
            const date = timeString ? parseUtcDate(timeString) : new Date();
            const timeFormatted = formatMessageTime(date);

            const box = document.getElementById("messagesBox");
            const div = document.createElement("div");
    
            div.className = sender === currentUserName ? "msg-item my-msg" : "msg-item";
            div.innerHTML = `
                <strong>${sender}:</strong> ${content} 
                <span style="font-size: 0.75em; color: #FFFFFF; float: right; margin-left: 15px; margin-top: 3px;">
                    ${timeFormatted}
                </span>`;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }

        async function createChannel() {
            const input = document.getElementById("channelName");
            if (!input.value.trim()) return;
            await fetch(API + "/channels", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name: input.value })
            });
            input.value = "";
            loadChannels();
        }

        async function loadChannels() {
            const res = await fetch(API + "/channels");
            const data = await res.json();
            const list = document.getElementById("channelsList");
            list.innerHTML = "";
            data.forEach(c => {
                const div = document.createElement("div");
                div.className = "channel-item";
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <b># ${c.name}</b>
                        <span class="badge bg-secondary">${c.memberCount}</span>
                    </div>

                    <div class="mt-2 d-flex gap-1">

                        <button class="btn btn-sm btn-outline-success flex-grow-1"
                                onclick="joinChannel('${c.id}')">

                            ${getText('join')}

                        </button>

                        <button class="btn btn-sm btn-primary flex-grow-1"
                                onclick="openChannel('${c.id}', '${c.name}')">

                            ${getText('open')}

                        </button>

                    </div>
                `;

                list.appendChild(div);
            });
        }

        async function joinChannel(id) {
            const res = await fetch(API + `/channels/${id}/join`, { method: "POST" });
            if(res.ok) loadChannels(); else alert(await res.text());
        }

        async function openChannel(id, name) {
            if (currentChannelId) connection.invoke("LeaveChat", currentChannelId.toString());
            currentChannelId = id;
            document.getElementById("chatHeader").innerText =
                getText("chatPrefix") + name;
            connection.invoke("JoinChat", id.toString());
            loadMessages();
        }

        async function loadMessages() {
            const secret_key = "my_secret_key";

            const res = await fetch(API + "/messages/" + currentChannelId);
            const box = document.getElementById("messagesBox");
            const input = document.getElementById("messageInput");
            const btn = document.getElementById("sendBtn");
            const emojiBtn = document.getElementById("emojiBtn");

            if(!res.ok) {
                box.innerHTML = "<div class='text-center m-auto text-muted'>Вступіть у канал, щоб бачити листування</div>";
                input.disabled = btn.disabled = emojiBtn.disabled = true;
                return;
            }



            input.disabled = btn.disabled = emojiBtn.disabled = false;
            const data = await res.json();
            box.innerHTML = "";
            data.forEach(item => {
                const bytes = CryptoJS.AES.decrypt(item.content, secret_key);
                const decrypted = bytes.toString(CryptoJS.enc.Utf8);

                appendMessageToScreen(item.senderName, decrypted, item.timestamp);
            });
        }

        const emojiMap = {
            ":)": "😁",
            ":-)": "😁",
            ":D": "😃",
            ":(": "😟",
            ":-(": "😢",
            ";)": "😉",
            "<3": "❤️",
            ":P": "😛",
            ":p": "😛",
            "XD": "😆",
            "xd": "😆",
            ":/": "😕"
        };

        function replaceEmojis(text) {
            let processedText = text;
            for (const [emoticon, emoji] of Object.entries(emojiMap)) {
                if (processedText.includes(emoticon)) {
                    processedText = processedText.split(emoticon).join(emoji);
                }
            }
            return processedText;
        }

        function toggleEmojiPicker() {
            document.getElementById("emojiPicker").classList.toggle("d-none");
        }

        function initEmojiPicker() {
            const picker = document.getElementById("emojiPicker");

            const emojis = ["😁", "😃", "😟", "😢", "😉",  "❤️",  "😛", "😆", "😕", "👍", "🔥", "😂", "😎", "🎉", "👀"];

            emojis.forEach(emoji => {
                const span = document.createElement("span");
                span.innerText = emoji;
                span.style.cursor = "pointer";
                span.style.fontSize = "1.4rem";
                span.style.userSelect = "none";

                span.onclick = () => {
                    const input = document.getElementById("messageInput");
                    input.value += emoji;
                    input.focus();
                    picker.classList.add("d-none");
                };

                picker.appendChild(span);
            });
        }

        initEmojiPicker();

        async function sendMessage() {
            const secret_key = "my_secret_key";
            const input = document.getElementById("messageInput");
            if (!currentChannelId || !input.value.trim()) return;

            const preFinalMessage = replaceEmojis(input.value);

            const finalMessage = CryptoJS.AES.encrypt(preFinalMessage, secret_key).toString();

            await fetch(API + "/messages", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ channelId: currentChannelId, content: finalMessage })
            });

            input.value = "";
        }

        document.getElementById("messageInput").addEventListener("keypress", (e) => { if (e.key === "Enter") sendMessage(); });

        async function loadUsers() {
            const res = await fetch(API + "/auth/users");
            if (!res.ok) return;

            const data = await res.json();
            const list = document.getElementById("usersList");
            list.innerHTML = "";

            data.forEach(u => {
                const div = document.createElement("div");
                div.className = "channel-item";
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <span><b>👤 ${u.userName}</b></span>
                        <span class="badge ${u.isOnline ? 'bg-success' : 'bg-secondary'}">
                            ${u.isOnline ? 'Online' : 'Offline'}
                        </span>
                    </div>

                    <div class="mt-2 d-flex gap-1">
                        <button class="btn btn-sm btn-primary flex-grow-1"
                                onclick="startPrivateChat('${u.id}', '${u.userName}')">
                            Написати
                        </button>
                    </div>
                `;
                list.appendChild(div);
            });
        }

        async function startPrivateChat(targetUserId, targetUserName) {
            const res = await fetch(API + "/channels/private", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ targetUserIds: [targetUserId] })
            });

            if (res.ok) {
                const channel = await res.json();

                openChannel(channel.id, "Приват: " + targetUserName);

                loadChannels();
            } else {
                const error = await res.text();
                alert("Помилка створення приватного чату: " + error);
            }
        }
    </script>
}